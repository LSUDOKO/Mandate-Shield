# ---------------------------------------------------------------------------
# Mandate Shield configuration
#
# Everything here is OPTIONAL. With no .env at all the project still runs:
# the agent falls back to a deterministic parser and the gateway to an
# in-process mock, so `npm test` and `npm run benchmark` work on a fresh clone.
# ---------------------------------------------------------------------------

# Groq powers intent parsing and product selection — the ONLY place an LLM runs.
# Omit to use the deterministic offline parser.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Razorpay test mode. Omit both to use the mock gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# HMAC secret backing application-layer actor identity claims (Check 5).
# Change this for any deployment that is not local development.
ACTOR_HMAC_SECRET=dev-only-change-me

PORT=3000
AUDIT_DB_PATH=./data/audit.db
